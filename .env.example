NEXT_PUBLIC_APP_URL=http://localhost:3000

SUPABASE_URL=https://your-project.supabase.co
# Server-only. Rotate this key if it has ever been committed or shared.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
APP_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Browser push notifications for matching talent jobs.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-web-push-public-key
VAPID_PRIVATE_KEY=replace-with-web-push-private-key

# MXroute HTTPS API uses these mailbox credentials and server name. No SMTP port is needed.
SMTP_HOST=chocobo.mxrouting.net
SMTP_AUTH_USER=no-reply@yoxaz.com
SMTP_AUTH_PASS=replace-with-smtp-password
SMTP_FROM="expo sphere <no-reply@yoxaz.com>"

# Server-only credentials used by `npm run auth:provision-admin`.
